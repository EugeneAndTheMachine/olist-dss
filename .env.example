# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.
# Lưu ý: không viết comment cùng dòng với giá trị (Makefile sẽ đọc cả khoảng trắng phía sau).

# --- PostgreSQL (warehouse) ---
# Chạy script trên máy: localhost. Trong container (Airflow) docker-compose tự đổi thành "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist
POSTGRES_DB=olist_dw
# Tên DB metadata của Airflow (được tạo trong docker/postgres/init/00_databases.sql, giữ nguyên "airflow")
AIRFLOW_DB=airflow

# --- MinIO (data lake) ---
# Trên máy: http://localhost:9000. Trong container: http://minio:9000 (docker-compose tự đổi).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKE_BUCKET=olist-lake
# Đổi tag nếu Docker không pull được image (xem docs/SETUP.md mục Xử lý sự cố)
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

# --- Kaggle (bỏ trống nếu đã đặt CSV vào data/raw/) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
# Thư mục chứa CSV tải tay (ecom_dataset/, marketing_funnel/, events_brazilstates/)
LOCAL_RAW_DIR=data/raw

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Windows: buộc Python/dbt đọc file bằng UTF-8 (dbt lỗi cp1252 với file có tiếng Việt) ---
PYTHONUTF8=1

# --- Cửa sổ phân tích (xác nhận ở S1) ---
ANALYSIS_START=2017-01-01
ANALYSIS_END=2018-08-31
