# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.
# Lưu ý: không viết comment cùng dòng với giá trị (Makefile sẽ đọc cả khoảng trắng phía sau).

# --- PostgreSQL (warehouse) ---
# Chạy script trên máy: localhost. Trong container (Airflow) docker-compose tự đổi thành "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist
POSTGRES_DB=olist_dw
# Tên DB metadata của Airflow (được tạo trong docker/postgres/init/00_databases.sql, giữ nguyên "airflow")
AIRFLOW_DB=airflow

# --- Data lake: Azure Blob Storage (thay MinIO) ---
# Mặc định: Azurite chạy local trong Docker (make up), connection string dev công khai của Microsoft.
# Dùng Azure thật (ADLS Gen2): Portal → Storage account → Security + networking → Access keys
#   (hoặc Shared access signature) → copy "Connection string" dán vào đây (xem docs/SETUP.md mục 5b).
# Không cần sửa cho Airflow: trong container, docker-compose tự đổi 127.0.0.1 → azurite.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
LAKE_CONTAINER=olist-lake
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.37.0

# --- Kaggle (bỏ trống nếu đã đặt CSV vào data/raw/) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
# Thư mục chứa CSV tải tay (ecom_dataset/, marketing_funnel/, events_brazilstates/)
LOCAL_RAW_DIR=data/raw

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Windows: buộc Python/dbt đọc file bằng UTF-8 (dbt lỗi cp1252 với file có tiếng Việt) ---
PYTHONUTF8=1

# --- Cửa sổ phân tích (xác nhận ở S1) ---
ANALYSIS_START=2017-01-01
ANALYSIS_END=2018-08-31
